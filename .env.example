# Copy to .env.local and fill in real values. NEVER commit real keys —
# this template holds placeholders only. Full explanation: ARCHITECTURE.md → Environment

# Stripe — payments (Orbit 77 contributions)
# Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase — database
# Credentials: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend — transactional email
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# The site's own origin. Used for API CORS and as the fallback return URL
# after Stripe checkout. Production: https://www.pyadra.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Orbit 77 dedicated database (OPTIONAL)
# Leave unset to fall back to the shared Pyadra Supabase above.
# Set both when Orbit 77 migrates to its own Supabase project — no code changes needed.
# ORBIT_SUPABASE_URL=https://orbit-project-id.supabase.co
# ORBIT_SUPABASE_SERVICE_ROLE_KEY=orbit_service_role_key_here

# Not read by any code today, kept because the CI build sets them:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: CRON_SECRET is no longer needed (on-demand delivery system)
# Note: EterniCapsule has its own .env in its own repo (pyadra/eternicapsule)
